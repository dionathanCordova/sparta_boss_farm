# Discord webhook that receives the alerts.
# Create it in Discord: Server Settings → Integrations → Webhooks → New Webhook
# → pick the channel → Copy Webhook URL.
DISCORD_WEBHOOK_URL=

# Minutes before spawn to send the "coming soon" warning (optional, default 10).
DISCORD_WARN_MINUTES=10

# Random secret that protects /api/cron/check from being called by strangers.
# Generate one with: openssl rand -hex 24
CRON_SECRET=

# Optional but STRONGLY recommended once you deploy to Vercel: without a
# real database, boss times are stored in a local JSON file that does not
# survive a redeploy (and may not even survive between requests, depending
# on the runtime). Create a free Upstash Redis database at
# https://console.upstash.com (or from the Vercel dashboard → Storage →
# Marketplace → Upstash) and paste the REST credentials here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
